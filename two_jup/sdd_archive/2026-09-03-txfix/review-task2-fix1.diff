+def test_verify_zip_margin_requires_the_f3b_marker(capsys):
+    d = tempfile.mkdtemp(prefix='txfixzip_')
+    zp = _make_zip(os.path.join(d, 'TxRxCompo_ip_v1_0.zip'), 'F3')
