index a2d4eb5..444f1a9 100644
--- a/host_app_k5/test_frame.c
+++ b/host_app_k5/test_frame.c
@@ -6,7 +6,9 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <stddef.h>
 #include "qpsk_frame.h"
+#include "qpsk_join.h"   /* COMB campaign: qpsk_fail_class + the log-record ABI */
 
